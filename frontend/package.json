{
  "name": "package-r-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run typecheck && vite build",
    "clean": "find ./dist -maxdepth 1 -mindepth 1 ! -name '.gitkeep' -exec rm -r {} +",
    "typecheck": "vue-tsc -p ./tsconfig.tsc.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "test": "playwright test"
  },
  "dependencies": {
    "@chenfengyuan/vue-number-input": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "ace-builds": "^1.44.0",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "filesize": "^11.0.24",
    "geotiff": "^3.0.5",
    "js-base64": "^3.9.4",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^17.0.6",
    "material-icons": "^1.13.14",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "pretty-bytes": "^7.1.3",
    "qrcode.vue": "^3.11.0",
    "tus-js-client": "^4.3.1",
    "utif": "^3.1.0",
    "video.js": "^8.24.1",
    "videojs-hotkeys": "^0.2.30",
    "videojs-mobile-ui": "^1.2.7",
    "vue": "^3.5.43",
    "vue-final-modal": "^4.5.5",
    "vue-i18n": "^11.4.12",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^5.3.1",
    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "terser": "^5.51.2",
    "vite": "^8.3.1",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.3.11"
  }
}
