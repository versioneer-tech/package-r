{
  "name": "package-r-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run typecheck && vite build",
    "clean": "make -C .. clean-frontend",
    "typecheck": "vue-tsc -p ./tsconfig.tsc.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "test": "playwright test"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "ace-builds": "^1.45.2",
    "core-js": "^3.51.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "filesize": "^11.0.34",
    "geotiff": "^3.0.5",
    "js-base64": "^3.9.7",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.2.1",
    "material-icons": "^1.13.14",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "tus-js-client": "^4.3.1",
    "utif": "^3.1.0",
    "video.js": "^8.24.2",
    "videojs-hotkeys": "^0.2.30",
    "videojs-mobile-ui": "^1.3.0",
    "vue": "^3.5.45",
    "vue-final-modal": "^5.0.1",
    "vue-i18n": "^11.4.18",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^5.5.1",
    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node22": "^22.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "postcss": "^8.5.28",
    "prettier": "^3.10.1",
    "rollup": "^4.68.6",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-compression2": "^2.5.4",
    "vue-tsc": "^3.3.14"
  }
