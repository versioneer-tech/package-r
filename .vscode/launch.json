{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run packageR",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev",
      "preLaunchTask": "prepare local development",
      "postDebugTask": "stop local S3",
      "serverReadyAction": {
        "pattern": "Listening on .*:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "env": {
        "CGO_ENABLED": "1",
        "PACKAGE_R_DATABASE": "${workspaceFolder}/.vscode/package-r.db",
        "PACKAGE_R_ADDRESS": "127.0.0.1",
        "PACKAGE_R_PORT": "8888",
        "PACKAGE_R_ROOT": "data",
        "AWS_ACCESS_KEY_ID": "my-access-key",
        "AWS_SECRET_ACCESS_KEY": "my-secret-key",
        "AWS_ENDPOINT_URL": "http://127.0.0.1:19100",
        "AWS_REGION": "us-east-1",
        "RCLONE_CONFIG": "/dev/null",
        "XDG_CACHE_HOME": "${workspaceFolder}/.vscode/cache"
      }
    }
  ]
}
