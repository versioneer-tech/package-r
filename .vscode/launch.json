{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "PackageR & STAC Browser",
      "configurations": [
        "PackageR with STAC Browser",
        "Local STAC Browser"
      ],
      "presentation": {
        "order": 2
      },
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "PackageR",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev",
      "preLaunchTask": "prepare local development",
      "postDebugTask": "stop local S3",
      "presentation": {
        "order": 1
      },
      "serverReadyAction": {
        "pattern": "Listening on .*:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "env": {
        "CGO_ENABLED": "1",
        "PACKAGE_R_DATABASE": "${workspaceFolder}/.vscode/package-r.db",
        "PACKAGE_R_ADDRESS": "127.0.0.1",
        "PACKAGE_R_PORT": "8888",
        "PACKAGE_R_ROOT": "data",
        "PACKAGE_R_CORS_ALLOWED_ORIGINS": "*",
        "PACKAGE_R_LOG_LEVEL": "DEBUG",
        "AWS_ACCESS_KEY_ID": "my-access-key",
        "AWS_SECRET_ACCESS_KEY": "my-secret-key",
        "AWS_ENDPOINT_URL": "http://127.0.0.1:19100",
        "AWS_REGION": "us-east-1",
        "RCLONE_CONFIG": "/dev/null",
        "XDG_CACHE_HOME": "${workspaceFolder}/.vscode/cache"
      }
    },
    {
      "name": "PackageR with STAC Browser",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev",
      "preLaunchTask": "prepare local development with STAC Browser",
      "postDebugTask": "stop local S3",
      "serverReadyAction": {
        "pattern": "Listening on .*:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "presentation": {
        "hidden": true
      },
      "env": {
        "CGO_ENABLED": "1",
        "PACKAGE_R_DATABASE": "${workspaceFolder}/.vscode/package-r.db",
        "PACKAGE_R_ADDRESS": "127.0.0.1",
        "PACKAGE_R_PORT": "8888",
        "PACKAGE_R_ROOT": "data",
        "PACKAGE_R_CORS_ALLOWED_ORIGINS": "*",
        "PACKAGE_R_LOG_LEVEL": "DEBUG",
        "AWS_ACCESS_KEY_ID": "my-access-key",
        "AWS_SECRET_ACCESS_KEY": "my-secret-key",
        "AWS_ENDPOINT_URL": "http://127.0.0.1:19100",
        "AWS_REGION": "us-east-1",
        "RCLONE_CONFIG": "/dev/null",
        "XDG_CACHE_HOME": "${workspaceFolder}/.vscode/cache"
      }
    },
    {
      "name": "Local STAC Browser",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --prefix ${env:HOME}/stac-browser start",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": true
      }
    }
  ]
}
